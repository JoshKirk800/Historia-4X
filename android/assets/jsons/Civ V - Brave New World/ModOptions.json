{
    "isBaseRuleset": true,
    // Score values of Brave New World (GlobalDefines.xml SCORE_*_MULTIPLIER)
    "constants": {
        "scoreFromCities": 8,
        "scoreFromPopulation": 4,
        "scoreFromWonders": 25,
        "scoreFromGreatWorks": 4,
        "scoreFromPolicies": 4,
        // SCORE_BELIEF_MULTIPLIER, SCORE_RELIGION_CITIES_MULTIPLIER
        "scoreFromReligionBeliefs": 20,
        "scoreFromReligionCities": 1,
        // CvGame::DoCacheMapScoreMod: 80 x 52, the standard world size
        "scoreBaseMapTiles": 4160,
        // CvMinorCivAI::CalculateBullyMetric: up to 75 for the military rank, up to 125 for the military near the City-State
        "tributeGlobalModifier": 75,
        "tributeLocalModifier": 125,
        // CvTreasury::CalculateUnitCost: GlobalDefines UNIT_MAINTENANCE_GAME_MULTIPLIER 8 (DefineChanges.sql:197) and UNIT_MAINTENANCE_GAME_EXPONENT_DIVISOR,
        // 7 in Brave New World and 5 in Vox Populi (DefineChanges.sql:200; the "6 in VP" comment of CvTreasury.cpp is stale);
        // no unit is free (the MaintenanceFreeUnits of the handicaps are 0 from Prince up)
        "unitMaintenanceFreeUnits": 0,
        "unitMaintenanceGameMultiplier": 8,
        "unitMaintenanceExponentDivisor": 5,
        // CvCity::setPopulation: GlobalDefines SCIENCE_PER_POPULATION, 1 in Community Patch, 0 in Vox Populi (DefineChanges.sql:350).
        // Kept at 1 until the science sources that replace it in Vox Populi (policies, traits, wonders, specialists in buildings) are flipped:
        // with 0 now the research of the half-flipped economy halves
        "sciencePerPopulation": 1,
        // CvPlayer::getGrowthThreshold: BASE_CITY_GROWTH_THRESHOLD 15, CITY_GROWTH_MULTIPLIER 12 and CITY_GROWTH_EXPONENT 2.22 (DefineChanges.sql:140-141; Brave New World 15, 8, 1.5)
        "cityGrowth": { "base": 15, "multiplier": 12, "exponent": 2.22 },
        // CvCityCitizens::GetSpecialistUpgradeThreshold: GREAT_PERSON_THRESHOLD_BASE 150 and GREAT_PERSON_THRESHOLD_INCREASE 250 (DefineChanges.sql:452-453; 100 and 100 in
        // Brave New World). Vox Populi counts the Great People of each kind apart (GLOBAL_SEPARATE_GP_COUNTERS 1), Units.json has a group for each of them
        "greatPersonThresholdBase": 150,
        "greatPersonThresholdIncrease": 250,
        // CvCity::GetJONSCultureThreshold
        "cultureCostLikeCivV": true,
        // CULTURE_COST_FIRST_PLOT 20, CULTURE_COST_LATER_PLOT_MULTIPLIER 12 and CULTURE_COST_LATER_PLOT_EXPONENT 1.35 (DefineChanges.sql:144-146;
        // Brave New World 15, 10 and 1.1; the comment in CvCity.cpp that says 15 for Vox Populi is stale)
        "borderCulture": { "first": 20, "laterPlotMultiplier": 12, "exponent": 1.35 },
        // CvTreasury::DoGold
        "treasuryNeverNegative": true,
        // CvPlayer::GetBuyPlotCost, CvCity::GetBuyPlotCost, CvCity::CanBuyPlot, CvCity::GetBuyablePlotList
        "plotAcquisitionLikeCivV": true,
        // CvPlot::changeAdjacentSight
        "sightBeyondRangeLikeCivV": true,
        // CvUnit::visibilityRange
        "minimumSightRange": 0,
        // CvPlayer::AddIncomingUnit: MINOR_UNIT_GIFT_TRAVEL_TURNS
        "unitGiftTravelTurns": 3,
        // CvUnit::currInterceptionProbability
        "airInterceptionChanceScalesWithHealth": true,
        // CvPlayer::DoUpdateUprisings
        "uprisingCounterLikeCivV": true,
        // Vox Populi's per-city needs and happiness (MOD_BALANCE_VP: CvCity::GetUnhappinessAggregated, CvCity::GetLocalHappiness, CvPlayer::DoUpdateTotalHappiness,
        // CvPlayer::CalculateNetHappiness). The numbers of ModConstants.needs are Vox Populi's GlobalDefines, which are its defaults: the BNW defines
        // UNHAPPINESS_PER_POPULATION, UNHAPPINESS_PER_CITY and UNHAPPINESS_PER_CAPTURED_CITY are 0 there (DefineChanges.sql) and so no longer exist as terms,
        // UNHAPPINESS_PER_OCCUPIED_POPULATION is 1.00 (needs.unhappinessPerOccupiedPopulation), luxuries give 2 (needs.happinessPerLuxury)
        "cityNeedsLikeVp": true,
        // CvUnit::fortifyModifier: no fortification bonus for a unit with ranged support fire (Zulu Impi)
        "rangedSupportFireUnitsGetNoFortification": true,
        // CvUnit::getMaxHurryProduction, getHurryProduction, canHurry
        "unitHurryLikeCivV": true,
        // AssignStartingPlots:PlaceSmallQuantitiesOfStrategics(23, land_list)
        "minorDepositsOnFlatLandOnly": true,
        "minorDepositFrequency": 23,
        // AssignStartingPlots:CanPlaceCityStateAt
        "cityStateSitesLikeCivV": true,
        // CvUnitCombat::ApplyNuclearExplosionDamage: NUKE_NON_COMBAT_DEATH_THRESHOLD
        "nukeCivilianDeathDamage": 6,
        // CvUnit::GetScrapGold: DISBAND_UNIT_REFUND_PERCENT
        "disbandRefundPercent": 25,
        // CvUnitMovement::GetCostsForMove: HILLS_EXTRA_MOVEMENT
        "featureOnHillsExtraMovement": 1,
        // CvCityBuildings::GetSellBuildingRefund: BUILDING_SALE_DIVISOR
        "buildingSaleDivisor": 4,
        // CvPlayer::SetUnitUpgradeCostMod, CvUnit::upgradePrice: UNIT_UPGRADE_COST_DISCOUNT_MAX
        "unitUpgradeCostModsAreSummed": true,
        // UNIT_UPGRADE_COST_DISCOUNT_MAX -99 ((2) Vox Populi/Database Changes/DefineChanges.sql:212, CvPlayer.cpp:24176). Vox Populi's option BALANCE_UNIT_UPGRADE_COST is on
        // (CustomModOptionChanges.sql:32): an upgrade costs the difference of the two units' purchase prices (CvGameCoreUtils.cpp:1361-1379), so UNIT_UPGRADE_COST_PER_PRODUCTION
        // 1.25 (DefineChanges.sql:209) is not read
        "unitUpgradeCostDiscountMax": -99,
        "unitUpgradeCostFromPurchasePrice": true,
        // CvTeam::DoMinorCivTech: MINOR_CIV_TECH_PERCENT
        "minorCivTechPercent": 40,
        // CvCity::doCheckProduction, CvCity::popOrder: MAXED_UNIT_GOLD_PERCENT, MAXED_BUILDING_GOLD_PERCENT
        "maxedUnitGoldPercent": 100,
        "maxedBuildingGoldPercent": 100,
        // CvCity::doTurn: CITY_HIT_POINTS_HEALED_PER_TURN plus capital and building defense
        "cityHealLikeCivV": true,
        // CvCity::DoSeedResourceDemandedCountdown, CvCity::DoTestResourceDemanded
        "resourceDemandLikeCivV": true,
        // CvPlot::canHaveImprovement: a seen resource takes only its own improvement, or one with "Can be built on tiles with any resource"
        "improvementsOnResourcesLikeCivV": true,
        // CvMap.cpp CvLandmass::isLake: LAKE_MAX_AREA_SIZE
        "maxLakeSize": 9,
        // CvGame::GetTurnsBetweenMinorCivElections
        "cityStateElectionsScaleWithGameSpeed": true,
        // CvPlayer::createGreatGeneral: GREAT_GENERALS_THRESHOLD_INCREASE, and CvPlayer::recomputeGreatPeopleModifiers: COMBAT_EXPERIENCE_IN_BORDERS_PERCENT
        "greatGeneralThresholdLikeCivV": true,
        "greatGeneralPercentInBorders": 100,
        // CvUnit::CanWithdrawFromMelee: WITHDRAW_MOD_ENEMY_MOVES -20, WITHDRAW_MOD_BLOCKED_TILE -20
        "withdrawLikeCivV": true,
        // CvCity::canRangeStrikeAt
        "citiesCanBombardCities": false,
        // CvUnit::PerformCultureBomb: CULTURE_BOMB_MINOR_FRIENDSHIP_CHANGE
        "cityStateInfluenceChangeForTilesTaken": -50,
        "cityStateInfluenceOncePerTilesTaken": true,
        // AssignStartingPlots:NormalizeStartLocation and NormalizeCityState
        "startNormalizerLikeCivV": true,
        // MapGenerator.lua GenerateCoasts: expansion_diceroll_table {4, 4}
        "coastExpansionDice": [4, 4],
        // AssignStartingPlots:PlaceOilInTheSea
        "seaDepositsOfLandResource": "Oil",
        // TerrainGenerator.lua and FeatureGenerator.lua
        "terrainGeneratorLikeCivV": true,
        // FeatureGenerator:AddFeatures of Vox Populi: a mountain on the coast is hills (Brave New World's keeps it)
        "noMountainsOnTheCoast": true,
        // AssignStartingPlots.lua of Brave New World (the Gods & Kings one differs: no cocoa, other counts)
        "luxuryPlacementLikeCivV": true,
        // PlaceLuxuries and PlaceIvory of Vox Populi's AssignStartingPlots.lua: 2 luxuries at each start, no compensation for a poor region, ivory of at least 2
        "startLuxuriesLikeVoxPopuli": true,
        // AssignStartingPlots:BalanceAndAssign of Brave New World (it differs from the Gods & Kings one by the civs placed first)
        "startAssignmentLikeCivV": true,
        // Vox Populi's AssignStartingPlots:GenerateRegions (continental method): civs settle a continent in pairs, so both civs of a Duel share one
        "regionAssignmentLikeVoxPopuli": true,
        // Vox Populi's AssignStartingPlots:CanPlaceCityStateAt, PlaceCityStateInRegion and the last-chance pass of PlaceCityStates: no edge, ice or fertile sites, discard instead of force
        "cityStatePlacementLikeVoxPopuli": true,
        // Vox Populi's AssignStartingPlots:FindStart and EvaluateCandidatePlot: one scored candidate list per area, coast +80, production minimums 1, 1, 3, no junk cap
        "startFinderLikeVoxPopuli": true,
        // AddExtraBonusesToHillsRegions, PlaceSexyBonusAtCivStarts, AddModernMinorStrategicsToCityStates, the strategic top-ups, FixSugarJungles
        "resourceExtrasLikeCivV": true,
        // AssignStartingPlots.lua of Vox Populi 5.4.8: PlaceStrategicAndBonusResources, AddModernMinorStrategicsToCityStates, PlaceSmallQuantitiesOfStrategics, PlaceOilInTheSea.
        // It replaces the strategic parts of the placement above (the major deposits per terrain, the small deposits at 23 tiles, the oil in the sea at 1 in 4, the top-ups)
        "strategicPlacementLikeVoxPopuli": true,
        "naturalWondersLikeCivV": true,
        "ancientRuinsLikeCivV": true,
        // Vox Populi's gold purchases: GOLD_PURCHASE_GOLD_PER_PRODUCTION 4 ((2) Vox Populi/Database Changes/DefineChanges.sql:214), HURRY_GOLD_PRODUCTION_EXPONENT 0.88 (:215),
        // GOLD_PURCHASE_VISIBLE_DIVISOR 10 (the unchanged default, CvCity.cpp:11904, 12205, 12269-12273)
        "purchase": { "goldPerProduction": 4.0, "exponent": 0.88, "visibleDivisor": 10 },
        // Building investments: option BALANCE_BUILDING_INVESTMENTS ((2) Vox Populi/Database Changes/CustomModOptionChanges.sql:31), HURRY_GOLD_BUILDING_COST_PERCENT 50
        // ((1) Community Patch/Database Changes/Defines/CoreDefineChanges.sql:464, used at CvCity.cpp:12261-12266) and BALANCE_BUILDING_INVESTMENT_BASELINE -50 (:465);
        // a world wonder's share is halved (CvCity.cpp:11685-11700)
        "buildingInvestments": true,
        "buildingInvestmentBaseline": -50,
        "buildingInvestmentWonderDivisor": 2,
        "goldBuildingCostPercent": 50,
        // Option BALANCE_WORLD_WONDER_COST_INCREASE (CustomModOptionChanges.sql:57), the BALANCE_WORLD_WONDER_*_ERA_COST_MODIFIER defines 25, 15, 10, 5 (CoreDefineChanges.sql:1076-1079)
        "worldWonderCostIncrease": [25, 15, 10, 5],
        // The purchase cooldowns of units (CvCity::Purchase, CvCity.cpp:2485-2503): no unit of this ruleset has one yet
        "purchaseCooldownEnabled": true,
        // CvPlayer::doInstantYield: the speed's InstantYieldPercent
        "instantYieldsUseInstantYieldPercent": true,
        // Vox Populi's whole trade route model: CvPlayerTrade::GetTradeConnectionValueTimes100 (CvTradeClasses.cpp:3604-4247) under BALANCE_VP ((2) Vox Populi/Database Changes/
        // CustomModOptionChanges.sql:2), with BALANCE_TRADE_ROUTE_PROXIMITY_PENALTY and BALANCE_TRADE_ROUTE_DESTINATION_RESTRICTION (:58-59). The eras' tradeRouteFoodBonus and
        // tradeRouteProductionBonus (Eras.TradeRouteFoodBonusTimes100 and ProductionBonusTimes100: 0, 100, 200, 400, 600, 800, 1000, 1200), the speeds' tradeRouteSpeedModifier
        // (GameSpeeds.TradeRouteSpeedMod 67, 100, 150, 300) and the route yields of buildings, improvements, traits and promotions are the data of the same model
        "tradeRouteModelLikeVp": true,
        // The defines of the model: INTERNATIONAL_TRADE_BASE 80, INTERNATIONAL_TRADE_CITY_GPT_DIVISOR 80, TRADE_ROUTE_BASE_SEA_MODIFIER 25 ((2) Vox Populi/Database Changes/
        // DefineChanges.sql:405-414, with TRADE_ROUTE_BASE_FOOD_VALUE and TRADE_ROUTE_BASE_PRODUCTION_VALUE 600, TRADE_ROUTE_DIFFERENT_RESOURCE_VALUE 5, TRADE_ROUTE_SCIENCE_DIVISOR_TIMES100
        // and TRADE_ROUTE_CULTURE_DIVISOR_TIMES100 125); the (1) Community Patch/Database Changes/Defines/CoreDefineChanges.sql:101, 1007-1025 ones Vox Populi keeps:
        // TRADE_ROUTE_BASE_LAND_MODIFIER 0, TRADE_ROUTE_RIVER_CITY_MODIFIER 25, TRADE_ROUTE_CS_ALLY_GOLD 2, TRADE_ROUTE_CS_FRIEND_GOLD 1, TRADE_ROUTE_CS_ALLY_SCIENCE_DELTA and
        // ..._CULTURE_DELTA 1, OPEN_BORDERS_MODIFIER_TRADE_GOLD 20, TRADE_ROUTE_BASE_TARGET_TURNS 30. proximityMax 50 is the cap in CvTradeClasses.cpp:3372-3418
        "tradeRouteVp": {
            "internationalTradeBase": 80, "cityGoldDivisor": 80, "seaModifier": 25, "landModifier": 0, "differentResourceValue": 5,
            "scienceDivisorTimes100": 125, "cultureDivisorTimes100": 125, "baseFoodValue": 600, "baseProductionValue": 600,
            "cityStateAllyGold": 2, "cityStateFriendGold": 1, "allyScienceDelta": 1, "allyCultureDelta": 1,
            "openBordersModifier": 20, "riverModifier": 25, "proximityMax": 50, "targetTurns": 30
        },
        // Worlds.TradeRouteDistanceMod (CvTradeClasses.cpp:5332-5390) is by world size, which this ruleset has no rule tables for (D22 O8): no entry, so 100 percent of the range
        // on every map (the table of the original is 80 Duel and Tiny, 90 Small, 100 Standard, 130 Large, 160 Huge)
        "worldTradeRouteDistance": [],
        // BALANCE_RESOURCE_SHORTAGE_UNIT_HEALING and BALANCE_RESOURCE_SHORTAGE_BUILDING_REFUND ((2) Vox Populi/Database Changes/CustomModOptionChanges.sql:47-48), with
        // STRATEGIC_RESOURCE_EXHAUSTED_PENALTY 0 (the combat malus of the original is off)
        "resourceShortageLikeVp": true,
        // CvDeal::BlockTemporaryForPermanentTrade (CvDealClasses.cpp:1368-1470) always applies in Vox Populi: only MOD_DEALAI_GLOBAL_PERMANENT_FOR_TEMPORARY (0, (1) Community Patch/
        // Database Changes/NewCustomModOptions.xml:652) lifts it between an AI and a human. DEALAI_HUMAN_PERMANENT_FOR_AI_TEMPORARY 1 (:131) and
        // DEALAI_NO_PEACETIME_SELLING_FOUNDED_CITIES 1 (:134, CvDealClasses.cpp:649) are on
        "dealsBlockTemporaryForPermanent": true,
        "dealHumanPermanentForAiTemporary": true,
        "dealNoPeacetimeSellingFoundedCities": true,
        // CvDealAI::GetLuxuryResourceValue, the BALANCE_VP branch (CvDealAI.cpp:1290-1590)
        "dealLuxuryValueLikeVp": true,
        // BALANCE_RESOURCE_MONOPOLIES and BALANCE_STRATEGIC_RESOURCE_MONOPOLIES ((2) Vox Populi/Database Changes/CustomModOptionChanges.sql:33-34), with
        // GLOBAL_RESOURCE_MONOPOLY_THRESHOLD 50 and STRATEGIC_RESOURCE_MONOPOLY_THRESHOLD 25 ((1) Community Patch/Database Changes/Defines/CoreDefineChanges.sql:108-109)
        "monopoly": { "globalThreshold": 50, "strategicThreshold": 25 },

        // ---- P6 military activation (M4): every switch of the staged slices, on, with Vox Populi 5.4.8's values ----
        // Maximum XP from combat with barbarians and minors: BARBARIAN_MAX_XP_VALUE 45, MINOR_MAX_XP_VALUE 70 ((2) Vox Populi/Database Changes/DefineChanges.sql:193-194),
        // CvUnit::maxXPValue and changeExperienceTimes100; the first attack of a turn only grants attacker XP (CvUnitCombat::ResolveMeleeCombat)
        "maxXPfromBarbarians": 45,
        "maxXPfromCityStates": 70,
        "combatXpCapsLikeVp": true,
        "combatXpFirstAttackOnly": true,
        // CvUnit::GetDamageCombatModifier, the enemy auras of CvUnit::GetMaxAttackStrength / GetMaxDefenseStrength, CvCity::SetRetroactivePromotion,
        // IsPromotionValidForCivilianUnitType, CvUnit::GetMaxHitPoints (the unique `[n] maximum hit points`), CvUnitEntry::IsMounted (CvUnit::canAcquirePromotion),
        // CvUnit::createCaptureUnit / getCaptureUnitType
        "combatHealthStrengthLikeVp": true,
        "enemyCombatAurasLikeVp": true,
        "retroactiveCityPromotionsLikeVp": true,
        "civilianPromotionApplicabilityLikeVp": true,
        "unitMaxHitPointsLikeVp": true,
        "mountedUnitFlagLikeVp": true,
        "captureClassLikeVp": true,
        // NONCOMBAT_UNIT_RANGED_DAMAGE 50 (DefineChanges.sql:97); the damage defines ATTACK_SAME_STRENGTH_MIN_DAMAGE 2400 and ..._POSSIBLE_EXTRA_DAMAGE 1200, RANGE_ATTACK_ ... and
        // CITY_ATTACKING_DAMAGE_MOD, ATTACKING_CITY_MELEE_DAMAGE_MOD 100 are the same in Brave New World and Vox Populi and are the defaults
        "combatDamage": { "rangedCivilianDamage": 50 },
        // EMBARKED_UNIT_MOVEMENT 3 (DefineChanges.sql:170), CvAStar's embark-aware path costs
        "embarkedUnitMovement": 3,
        "embarkAwarePathingLikeVp": true,
        // ENEMY_HEAL_RATE 5, NEUTRAL_HEAL_RATE 10, FRIENDLY_HEAL_RATE 15, CITY_HEAL_RATE 20 (DefineChanges.sql:89-92), CvUnit::healRate with MOD_BALANCE_VP
        "enemyUnitHeal": 5,
        "neutralUnitHeal": 10,
        "friendlyUnitHeal": 15,
        "cityUnitHeal": 20,
        "unitHealingLikeVp": true,
        "stateReligionHealingLikeVp": true,
        // CvCity::GetMaxHitPoints, updateStrengthValue, getStrengthValue, doTurn: MAX_CITY_HIT_POINTS 250, CITY_STRENGTH_POPULATION_CHANGE 8, CITY_STRENGTH_DEFAULT 500,
        // CITY_STRENGTH_HILL_CHANGE 200, CITY_STRENGTH_LAND_UNIT_DIVISOR 200, CITY_STRENGTH_NAVAL_UNIT_DIVISOR 400, CITY_RANGED_ATTACK_STRENGTH_MULTIPLIER 0,
        // CITY_HIT_POINTS_HEALED_PER_TURN 8 (DefineChanges.sql:59-84: these are the defaults of CityCombatConstants); PROCESS_DEFENSE: DefenseValue 10, per turn 1, cap 15 (Processes table;
        // its tech Archery is the Military Strategy of this ruleset, see the Y4 note on Archery)
        "cityCombatLikeVp": true,
        "cityCombat": { "defenseProcesses": { "Defense": { "defense": 10, "defensePerTurn": 1, "defenseCap": 15, "requiredTech": "Military Strategy" } } },
        // CvPlayer::GetUnitSupplyBreakdown and the defines of DefineChanges.sql:168-195: UNIT_SUPPLY_BASE_TECH_REDUCTION_PER_ERA 100, UNIT_SUPPLY_CITIES_TECH_REDUCTION_MULTIPLIER 100,
        // UNIT_SUPPLY_POPULATION_TECH_REDUCTION_MULTIPLIER 100, Worlds.NumCitiesUnitSupplyMod 5, PRODUCTION_PENALTY_PER_UNIT_OVER_SUPPLY 5, GROWTH_PENALTY_PER_UNIT_OVER_SUPPLY 5,
        // MAX_UNIT_SUPPLY_PRODMOD and MAX_UNIT_SUPPLY_GROWTH_MOD 70
        "unitSupplyLikeVp": true,
        "unitSupplyConstants": {
            "baseTechReductionPerEra": 100, "citiesTechReductionMultiplier": 100, "populationTechReductionMultiplier": 100, "empireSizePenaltyPerCity": 5,
            "productionPenaltyPerUnit": 5, "maxProductionPenalty": 70, "growthPenaltyPerUnit": 5, "maxGrowthPenalty": 70
        },
        // The promotion and unit columns of Vox Populi: ExtraFlankPower, IgnoreTerrainCostIn / HalfMove / ExtraMove, GainsXPFromScouting (BALANCE_SCOUT_XP_*: 12 and 10, the defaults),
        // XPFromPillaging, LostOnGifting, MinorCivGift / NoMinorCivGift
        "flankPowerLikeVp": true,
        "terrainMovementPromotionsLikeVp": true,
        "scoutingXpLikeVp": true,
        "pillageXpLikeVp": true,
        "giftPromotionLossLikeVp": true,
        "cityStateGiftUnitFlagsLikeVp": true,
        // Air: BASE_CITY_AIR_STACKING 2 and AIR_UNIT_REBASE_RANGE_MULTIPLIER 500 (DefineChanges.sql:100-103), MOD_BALANCE_AIR_UNIT_CHANGES (land air defense), CvPlot::GetBestInterceptor
        "airBasingLikeVp": true,
        "airBasing": { "cityAirUnitCapacity": 2, "rebaseRangeMultiplier": 500 },
        "airDefenseLikeVp": true,
        "airInterceptionLikeVp": true,
        // CvPlayer::acquireCity (CITY_CAPTURE_POPULATION_PERCENT 75, BALANCE_CONQUEST_REDUCTION_BOOST 5, CITY_CAPTURE_DAMAGE_PERCENT 50, COMBAT_CAPTURE_HEALTH 75): the defaults of
        // ConquestConstants. combatCaptureHealthIsDamage stays true, as in the source: a captured unit keeps 25% of its health (CvUnit::createCaptureUnit passes COMBAT_CAPTURE_HEALTH to setDamage)
        "conquestLikeVp": true,
        // CvBarbarians (the BARBARIAN_* defines of Vox Populi): the defaults of BarbarianConstants
        "barbariansLikeVp": true
    },
}
